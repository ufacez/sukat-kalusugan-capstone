# --- Secrets / local config ---
# config.php itself no longer holds secrets (moved to .env below) --
# it now only contains env() calls with safe defaults, so it's safe
# and correct to track it in git going forward. Only .env stays ignored.
.env
.env.*

# --- OS junk ---
.DS_Store
Thumbs.db

# --- Editor / IDE ---
.vscode/
.idea/
*.swp

# --- AI agent / assistant local state ---
.cursor/
.claude/
.windsurf/
.aider*
CLAUDE.md
*.prompt.md

# --- PHP / server local artifacts ---
*.log
vendor/
composer.lock

# --- Debug / throwaway scripts ---
public_html/test/*

# Private Excel/reference files
public_html/data/*
