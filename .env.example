# =============================================================================
# Sukat Kalusugan — Environment Configuration (TEMPLATE)
# =============================================================================
# Copy this file to .env and fill in your local values:
#   cp .env.example .env
# =============================================================================

# --- Application ---
APP_ENV=development
# Canonical public base URL used for links inside emails (reset, activation).
# Live: APP_URL=https://sukatkalusugan.app
APP_URL=
# Force http→https redirects (except /api/esp32/*, which the ESP32 needs over
# plain HTTP). Default: ON when APP_ENV=production, OFF otherwise.
# Live (Azure): leave empty (auto-on). Local XAMPP: leave empty (auto-off).
# FORCE_HTTPS=1 forces on everywhere; FORCE_HTTPS=0 disables everywhere.
FORCE_HTTPS=

# --- Database (MySQL / MariaDB) ---
DB_HOST=localhost
DB_NAME=sukat_kalusugan
DB_USER=root
DB_PASS=

# --- Staging gate (Codespaces QA only; leave empty on prod/local) ---
STAGING_PASSWORD=

# --- PII At-Rest Encryption (AES-256-GCM) ---
# Optional. Empty = disabled (plaintext, current behavior).
# To enable: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# then paste the output below. Use the SAME key on XAMPP + Azure VM.
# After enabling: import db/20261001_pii_encryption_columns.sql, then
# run: php tools/encrypt_pii.php --apply
APP_ENCRYPTION_KEY=

# --- ESP32 Kiosk Device Auth ---
# Shared secret for ESP32 — must match DEVICE_KEY in the .ino firmware exactly.
# Generate: php -r "echo bin2hex(random_bytes(32));"
ESP32_DEVICE_KEY=

# --- Firebase Realtime Database ---
FIREBASE_DATABASE_URL=
FIREBASE_AUTH_TOKEN=

# --- SMTP / Email (Gmail) ---
# Setup: enable 2FA on Gmail, create an App Password, paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=
SMTP_PASS=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Sukat Kalusugan"

# --- SMS / UniSMS (staff invitation codes) ---
# SMTP is email-only and cannot send SMS. Invitation codes are delivered via
# BOTH email and UniSMS SMS; activation requires the invitation code only.
# Setup: sign up at https://unismsapi.com/register, verify your mobile number
# for 10 free credits, then copy the secret key from API Keys.
# The default Sender ID reaches ONLY Globe/DITO; Smart/TNT/Sun are refused.
# Use the exact Sender ID shown in the UniSMS dashboard (docs use "Unisoft").
# Pricing: ₱0.50/SMS after free credits; top-up starts at ₱500; no links.
UNISMS_SECRET_KEY=
UNISMS_SENDER_ID=Unisoft
# SMS_DRY_RUN=true logs the message instead of calling UniSMS — no credits
# spent. Useful for local invite/activation testing; leave unset on live.
SMS_DRY_RUN=

# --- AI Chatbot (Growth Result Assistant) ---
# Leave CHATBOT_API_KEY empty to keep the chatbot disabled.
CHATBOT_PROVIDER=gemini
CHATBOT_API_KEY=
CHATBOT_MODEL=gemini-2.0-flash
CHATBOT_API_URL=

# --- Nutritionist Dashboard AI (optional overrides) ---
# Leave empty to fall back to the shared CHATBOT_* values above.
NUTRITIONIST_AI_PROVIDER=
NUTRITIONIST_AI_KEY=
NUTRITIONIST_AI_MODEL=
