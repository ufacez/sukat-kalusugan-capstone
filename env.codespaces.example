# =============================================================================
# Sukat Kalusugan — Codespaces STAGING template (NO secrets committed here)
# =============================================================================
# Setup inside the Codespace (run once):
#   cp env.codespaces.example .env
#   # then fill DB_PASS + STAGING_PASSWORD from Codespaces Secrets / owner,
#   # and set APP_URL to the forwarded 8080 URL.
# .env itself is gitignored — never commit it.
# =============================================================================

# --- Application (staging locks these; do not change) ---
APP_ENV=staging
# Canonical URL of THIS codespace, e.g. APP_URL=https://xxx-8080.app.github.dev
# Used for links inside emails. Leave empty only for purely local clicks.
APP_URL=
# Codespaces terminates TLS at its proxy; the app sees plain HTTP internally.
FORCE_HTTPS=0

# --- Database (staging-only MySQL service, test data only) ---
DB_HOST=db
DB_NAME=sukat_staging
DB_USER=sukat
# Staging-only password (Codespaces Secret). NEVER reuse the prod password.
DB_PASS=

# --- Staging gate (shared password for QA/teacher; Codespaces Secret) ---
# Required. The app shows a password gate until this is entered (or sent as
# X-Staging-Key header for API testing). Rotate after each pen-test window.
STAGING_PASSWORD=

# --- ESP32 Kiosk Device Auth (staging) ---
# Test-only key. Must match DEVICE_KEY in test firmware if kiosk is exercised.
ESP32_DEVICE_KEY=staging-test-key-change-me

# --- Disabled in staging (leave empty) ---
# Email, Firebase mirror, and AI keys stay EMPTY so staging can never send
# real mail, mirror to prod Firebase, or spend AI quota.
FIREBASE_DATABASE_URL=
FIREBASE_AUTH_TOKEN=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=
SMTP_PASS=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Sukat Kalusugan (staging)
CHATBOT_PROVIDER=gemini
CHATBOT_API_KEY=
CHATBOT_MODEL=
CHATBOT_API_URL=
NUTRITIONIST_AI_PROVIDER=
NUTRITIONIST_AI_KEY=
NUTRITIONIST_AI_MODEL=
